# Laravel catalog/commerce API (Sanctum). Paths are under /api.
VITE_CATALOG_SERVICE_URL=http://localhost:8000/api
VITE_COMMERCE_SERVICE_URL=http://localhost:8000/api

# Dispute AI (FastAPI). Prefer the Vite proxy path so CORS is same-origin in dev:
#   /api/ai → rewritten to FastAPI root (see vite.config.js).
# Point the proxy target at the AI-Agent host (default 8080 so it does not clash with Laravel :8000).
VITE_AI_SERVICE_URL=/api/ai

# Product-recommend stub (Mia on Home) — Laravel AiController, NOT FastAPI.
VITE_RECOMMEND_AI_URL=http://localhost:8000/api/ai

VITE_API_TIMEOUT_MS=40000
VITE_AI_HEALTH_POLL_MS=25000

# Vite proxy target for /api/ai (dispute FastAPI). Local default:
# VITE_AI_PROXY_TARGET=http://127.0.0.1:8080
# Deployed AWS ALB example (HTTP):
# VITE_AI_PROXY_TARGET=http://disput-Publi-Ui1r9QlmTptv-514667223.us-west-2.elb.amazonaws.com

# Langfuse dashboard for Admin → Multi-Agent / Observability
# EU: https://cloud.langfuse.com  ·  US: https://us.cloud.langfuse.com
VITE_LANGFUSE_URL=https://cloud.langfuse.com
# Optional — deep-link Traces/Prompts/Scores into your project
# (copy project id from Langfuse URL: /project/<THIS_ID>/...)
# VITE_LANGFUSE_PROJECT_ID=